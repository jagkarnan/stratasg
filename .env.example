# Email delivery for both forms goes through Resend.
# Optional automation endpoint (Zapier, Make, n8n, HubSpot, etc.)
LEADS_WEBHOOK_URL=

# Platform tracking IDs. Google Ads is already configured in app/layout.tsx.
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Resend. RESEND_FROM = verified sender address (default contact@strata.sg).
RESEND_API_KEY=
RESEND_FROM=
